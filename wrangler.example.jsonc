{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiaotian-vps-radar",
  "main": "worker.js",
  "compatibility_date": "2026-11-20",
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "SITE_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "SITE_HOST": "vps.yourdomain.com",
    "INDEXNOW_KEY": ""
  },
  "triggers": {
    "crons": ["0 */4 * * *"]
  },
  "routes": [
    {
      "pattern": "vps.yourdomain.com",
      "custom_domain": true
    }
  ]
}
